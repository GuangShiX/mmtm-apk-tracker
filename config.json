{
    "package_name": "jp.boi.mementomori.android",
    "apkeep_path": "bin/apkeep.exe",
    "source": "apk-pure",
    "check_interval_seconds": 3600,
    "download_retries": 3,
    "download_timeout_seconds": 1800,
    "verify_download_crc": true,
    "google_play": {
        "email": "",
        "token": ""
    },
    "oss": {
        "enabled": false,
        "endpoint": "https://oss-cn-beijing.aliyuncs.com",
        "bucket": "",
        "prefix": "mementomori",
        "cdn_base_url": "",
        "publish_after_extract": true,
        "skip_if_published": false
    },
    "dirs": {
        "apks": "apks",
        "extracted": "extracted",
        "reports": "reports"
    }
}
