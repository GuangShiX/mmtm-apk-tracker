# Run `python publish.py --configure` instead of storing real credentials here.
MMTM_OSS_ENABLED="true"
OSS_ENDPOINT="https://oss-cn-beijing.aliyuncs.com"
OSS_BUCKET="your-private-bucket-name"
OSS_PREFIX="mementomori"
CDN_BASE_URL="https://assets.example.com"
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""

# Cloudflare R2 credentials. Scope the token to one bucket with Object Read & Write.
MMTM_R2_ENABLED="true"
R2_ACCOUNT_ID=""
R2_BUCKET="mementomori-assets"
R2_PREFIX="mementomori"
R2_PUBLIC_BASE_URL="https://assets.example.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
